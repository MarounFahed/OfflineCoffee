<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">{%- endif -%}
    {%- comment -%} Fonts self-hosted via @font-face in theme.css. {%- endcomment -%}
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
    <title>{{ shop.name | upcase }}</title>
    {{ content_for_header }}
  </head>
  <body class="template-password">
    {{ content_for_layout }}
    <main role="main" class="hero password-hero" style="--mood: var(--pine);">
      <h1 class="hero-heading">{{ shop.name }}</h1>
      <p class="password-lead">{{ shop.password_message | default: 'Coming soon.' }}</p>

      <div style="margin-top: var(--s-6);">
        {% form 'customer' %}
          <span class="password-signup-label">{{ 'password.signup' | t }}</span>
          <div style="display:flex; gap:var(--s-3); flex-wrap:wrap; max-width:480px;">
            <input type="hidden" name="contact[tags]" value="prospect, password page">
            <input type="email" name="contact[email]" placeholder="{{ 'password.email_placeholder' | t }}" required style="flex:1; min-width: 200px; min-height: 44px; padding: 14px 16px; background: transparent; border: 1px solid var(--paper); color: var(--paper); font-family: var(--mono); font-size: 12px; letter-spacing: 0.08em;">
            <button class="btn">{{ 'password.send' | t }}</button>
          </div>
          {%- if form.posted_successfully? -%}
            <span class="mono" style="display:block; margin-top:var(--s-3);">{{ 'password.signup_success' | t }}</span>
          {%- endif -%}
        {% endform %}
      </div>

      <div class="password-admin">
        {% form 'storefront_password' %}
          {%- if form.errors -%}
            <div class="form-error">{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}</div>
          {%- endif -%}
          <span>{{ 'password.admin_label' | t }}</span>
          <input
            type="password"
            name="password"
            id="Password"
            autocomplete="current-password"
            placeholder="{{ 'password.password_placeholder' | t }}">
          <button type="submit">{{ 'password.enter' | t }}</button>
        {% endform %}
      </div>
    </main>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
