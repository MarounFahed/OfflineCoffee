<section class="section" aria-label="{{ section.settings.heading | default: 'Journal' | strip_html }}">
  <div class="wrap">
    <div class="section-head">
      <div class="lbl">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading | newline_to_br }}</h2>
      <div class="meta">{{ section.settings.meta | newline_to_br }}</div>
    </div>

    <div class="journal">
      {%- liquid
        assign blog_handle = section.settings.blog
        assign post_count = section.settings.posts_count | default: 3
        assign source_blog = blogs[blog_handle]
      -%}

      {%- if source_blog and source_blog.articles.size > 0 -%}
        {%- for article in source_blog.articles limit: post_count -%}
          <a class="journal-card" href="{{ article.url }}">
            <div class="journal-art">
              {%- if article.image != blank -%}
                {%- assign img_alt = article.image.alt | default: article.title -%}
                {% render 'responsive-image',
                  image: article.image,
                  sizes: '(min-width: 990px) 33vw, 100vw',
                  widths: '400, 600, 900, 1200',
                  alt: img_alt %}
              {%- else -%}
                <span class="lbl">[ {{ article.title | upcase | truncate: 24 }} ]</span>
              {%- endif -%}
            </div>
            <div class="journal-meta">{{ article.published_at | date: '%d %b' }} · {%- if article.metafields.offline.read_minutes -%}{{ article.metafields.offline.read_minutes }} min{%- else -%}{{ article.content | strip_html | split: ' ' | size | divided_by: 200 | append: ' min' }}{%- endif -%} · {{ article.tags | first | default: 'Journal' }}</div>
            <h3 class="journal-title">{{ article.title }}</h3>
            <p class="journal-dek">{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Placeholder posts when no blog content yet {%- endcomment -%}
        {%- for block in section.blocks -%}
          <a class="journal-card" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
            <div class="journal-art">
              {%- if block.settings.image != blank -%}
                {% render 'responsive-image',
                  image: block.settings.image,
                  sizes: '(min-width: 990px) 33vw, 100vw',
                  widths: '400, 600, 900, 1200',
                  alt: block.settings.title %}
              {%- else -%}
                <span class="lbl">{{ block.settings.image_label }}</span>
              {%- endif -%}
            </div>
            <div class="journal-meta">{{ block.settings.meta }}</div>
            <h3 class="journal-title">{{ block.settings.title }}</h3>
            <p class="journal-dek">{{ block.settings.dek }}</p>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Journal preview",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "§ 04 — The Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Field notes.\nBrew logs." },
    { "type": "text", "id": "meta", "label": "Meta (right)", "default": "Updated\nevery Thursday" },
    { "type": "blog", "id": "blog", "label": "Source blog (optional)" },
    { "type": "range", "id": "posts_count", "label": "Number of posts", "min": 1, "max": 6, "step": 1, "default": 3 },
    { "type": "paragraph", "content": "If no blog is selected (or the blog has no posts yet), the placeholder cards below render instead." }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Placeholder post",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_label", "label": "Image label (when no image)", "default": "[ EDITORIAL · 1600 × 1000 ]" },
        { "type": "text", "id": "meta", "label": "Meta (date · read · tag)", "default": "14 Aug · 6 min · Brewing" },
        { "type": "text", "id": "title", "label": "Title", "default": "A kettle is the only thing you need." },
        { "type": "textarea", "id": "dek", "label": "Dek", "default": "An argument against bringing the AeroPress, the grinder, the scale, and the bean canister to a four-day backpacking trip." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Journal preview",
      "blocks": [
        { "type": "post", "settings": { "meta": "14 Aug · 6 min · Brewing", "title": "A kettle is the only thing you need.", "dek": "An argument against bringing the AeroPress, the grinder, the scale, and the bean canister to a four-day backpacking trip." } },
        { "type": "post", "settings": { "meta": "07 Aug · 4 min · Origins", "title": "Why we steep instead of drip.", "dek": "Drip needs gear. Steeping needs hot water and patience. We chose the second one for reasons that became obvious in a tent." } },
        { "type": "post", "settings": { "meta": "31 Jul · 8 min · Travel", "title": "Hotel room coffee: a field guide.", "dek": "Every business hotel has a kettle. Most have a coffee maker that has not been cleaned since 2017. Use the kettle." } }
      ]
    }
  ]
}
{% endschema %}
