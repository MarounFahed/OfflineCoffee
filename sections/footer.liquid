{%- liquid
  assign mark_size = section.settings.wordmark_size
  assign mark_class = 'footer-mark'
  if mark_size == 's'
    assign mark_class = 'footer-mark footer-mark--s'
  elsif mark_size == 'm'
    assign mark_class = 'footer-mark footer-mark--m'
  elsif mark_size == 'xl'
    assign mark_class = 'footer-mark footer-mark--xl'
  endif
-%}

{%- if section.settings.show_spectrum -%}
  <div class="spectrum" aria-hidden="true">
    <i></i><i></i><i></i>
  </div>
{%- endif -%}

<footer class="footer" role="contentinfo">
  <div class="footer-inner">
    <div class="footer-cols">
      <div class="footer-news">
        <h3>{{ section.settings.newsletter_heading | default: 'Notes from offline.' }}</h3>
        <p>{{ section.settings.newsletter_body }}</p>
        {% form 'customer', class: 'news-input' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" aria-label="{{ 'general.newsletter.placeholder' | t }}" required>
          <button type="submit">{{ 'general.newsletter.submit' | t }}</button>
          {%- if form.posted_successfully? -%}
            <span class="visually-hidden">{{ 'general.newsletter.success' | t }}</span>
          {%- endif -%}
        {% endform %}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu_column' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            <ul role="list">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="{{ mark_class }}" aria-hidden="true">{{ section.settings.wordmark | default: 'OFFLINE' }}</div>

    <div class="footer-fine">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}.</span>
      <span>{{ settings.footer_fine_print }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Notes from offline."
    },
    {
      "type": "textarea",
      "id": "newsletter_body",
      "label": "Body",
      "default": "One letter a month. No urgency. Coffee tips, a place to be, occasional opinions about kettles."
    },
    {
      "type": "header",
      "content": "Wordmark"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Big wordmark text",
      "default": "OFFLINE"
    },
    {
      "type": "select",
      "id": "wordmark_size",
      "label": "Size",
      "options": [
        { "value": "s", "label": "Small" },
        { "value": "m", "label": "Medium" },
        { "value": "l", "label": "Large" },
        { "value": "xl", "label": "Extra large" }
      ],
      "default": "l"
    },
    {
      "type": "header",
      "content": "Roast spectrum strip"
    },
    {
      "type": "checkbox",
      "id": "show_spectrum",
      "label": "Show roast spectrum strip above footer",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu_column", "settings": { "heading": "Shop" } },
        { "type": "menu_column", "settings": { "heading": "Story" } },
        { "type": "menu_column", "settings": { "heading": "Service" } }
      ]
    }
  ]
}
{% endschema %}
