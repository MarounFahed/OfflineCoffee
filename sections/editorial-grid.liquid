<section class="section places-section" aria-label="{{ section.settings.heading | default: 'Editorial' | strip_html }}">
  <div class="wrap">
    <div class="section-head">
      <div class="lbl">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading | newline_to_br }}</h2>
      <div class="meta">{{ section.settings.meta | newline_to_br }}</div>
    </div>

    <div class="places">
      {%- for block in section.blocks -%}
        <div class="place-card" {{ block.shopify_attributes }}>
          <div class="place-art">
            {%- if block.settings.image != blank -%}
              {% render 'responsive-image',
                image: block.settings.image,
                sizes: '(min-width: 990px) 33vw, 100vw',
                widths: '400, 600, 800, 1200',
                alt: block.settings.title %}
            {%- endif -%}
            {%- if block.settings.stamp != blank -%}
              <div class="stamp">{{ block.settings.stamp }}</div>
            {%- endif -%}
            {%- if block.settings.label != blank -%}
              <span>{{ block.settings.label }}</span>
            {%- endif -%}
          </div>
          <div class="place-title">{{ block.settings.title }}</div>
          <div class="place-meta">
            <span>{{ block.settings.meta_left }}</span>
            <span>{{ block.settings.meta_right }}</span>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "§ 03 — Where it goes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for the places\nwithout good coffee." },
    { "type": "text", "id": "meta", "label": "Meta (right)", "default": "A balcony\ncounts too" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "stamp", "label": "Coordinate stamp", "default": "N 44°25′ / W 110°35′" },
        { "type": "text", "id": "label", "label": "Bottom-right label", "default": "[ TENT · 06:14 AM ]" },
        { "type": "text", "id": "title", "label": "Title", "default": "Two-person tent, Yellowstone backcountry." },
        { "type": "text", "id": "meta_left", "label": "Meta — left", "default": "Site #14" },
        { "type": "text", "id": "meta_right", "label": "Meta — right", "default": "Aug" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Editorial grid",
      "blocks": [
        { "type": "card", "settings": { "stamp": "N 44°25′ / W 110°35′", "label": "[ TENT · 06:14 AM ]", "title": "Two-person tent, Yellowstone backcountry.", "meta_left": "Site #14", "meta_right": "Aug" } },
        { "type": "card", "settings": { "stamp": "N 40°45′ / W 73°59′", "label": "[ TRAIN · 07:02 AM ]", "title": "Northbound Amtrak, somewhere past Poughkeepsie.", "meta_left": "Car 7", "meta_right": "Sept" } },
        { "type": "card", "settings": { "stamp": "N 35°41′ / E 139°41′", "label": "[ HOTEL · 05:48 AM ]", "title": "Business hotel, Shibuya. Kettle in the closet.", "meta_left": "Room 1402", "meta_right": "Oct" } }
      ]
    }
  ]
}
{% endschema %}
