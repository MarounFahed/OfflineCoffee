<section class="section places-section" aria-label="{{ section.settings.heading | default: 'Editorial' | strip_html }}">
  <div class="wrap">
    <div class="section-head">
      <div class="lbl">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading | newline_to_br }}</h2>
      <div class="meta">{{ section.settings.meta | newline_to_br }}</div>
    </div>

    <div class="places">
      {%- for block in section.blocks -%}
        <div class="place-card" {{ block.shopify_attributes }}>
          <div class="place-art">
            {%- if block.settings.image != blank -%}
              {% render 'responsive-image',
                image: block.settings.image,
                sizes: '(min-width: 990px) 33vw, 100vw',
                widths: '400, 600, 800, 1200',
                alt: block.settings.title %}
            {%- elsif block.settings.image_url != blank -%}
              <img
                src="{{ block.settings.image_url }}&width=800"
                srcset="{{ block.settings.image_url }}&width=400 400w, {{ block.settings.image_url }}&width=600 600w, {{ block.settings.image_url }}&width=800 800w, {{ block.settings.image_url }}&width=1200 1200w"
                sizes="(min-width: 990px) 33vw, 100vw"
                alt="{{ block.settings.title | escape }}"
                loading="lazy">
            {%- endif -%}
          </div>
          <div class="place-title">{{ block.settings.title }}</div>
          {%- if block.settings.location != blank -%}
            <div class="place-location">{{ block.settings.location }}</div>
          {%- endif -%}
          <div class="place-meta">
            <span>{{ block.settings.meta_left }}</span>
            <span>{{ block.settings.meta_right }}</span>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "§ 03 — Where it goes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for the places\nwithout good coffee." },
    { "type": "text", "id": "meta", "label": "Meta (right)", "default": "A balcony\ncounts too" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Image URL (fallback, advanced)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Two-person tent, Yellowstone backcountry." },
        { "type": "text", "id": "location", "label": "Location", "default": "Yellowstone National Park, Wyoming" },
        { "type": "text", "id": "meta_left", "label": "Meta — left", "default": "Site #14" },
        { "type": "text", "id": "meta_right", "label": "Meta — right", "default": "Aug" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Editorial grid",
      "blocks": [
        { "type": "card", "settings": { "title": "Two-person tent, Yellowstone backcountry.", "location": "Yellowstone National Park, Wyoming", "meta_left": "Site #14", "meta_right": "Aug" } },
        { "type": "card", "settings": { "title": "Northbound Amtrak, somewhere past Poughkeepsie.", "location": "Hudson Valley, New York", "meta_left": "Car 7", "meta_right": "Sept" } },
        { "type": "card", "settings": { "title": "Business hotel, Shibuya. Kettle in the closet.", "location": "Shibuya, Tokyo", "meta_left": "Room 1402", "meta_right": "Oct" } }
      ]
    }
  ]
}
{% endschema %}
