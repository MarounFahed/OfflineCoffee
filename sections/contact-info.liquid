<section class="contact-section">
  <div class="contact-grid">
    <div class="contact-form-col">
      <h2>{{ section.settings.form_heading }}</h2>
      {%- form 'contact', class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="form-success" role="status">{{ 'contact.success' | t }}</div>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="form-error" role="alert">
            {%- for field in form.errors -%}
              <span>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}.</span>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="field">
          <label for="ContactName">{{ 'contact.name' | t }}</label>
          <input type="text" id="ContactName" name="contact[name]" value="{{ form.name }}" autocomplete="name" required>
        </div>

        <div class="field">
          <label for="ContactEmail">{{ 'contact.email' | t }}</label>
          <input type="email" id="ContactEmail" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
        </div>

        <div class="field">
          <label for="ContactMessage">{{ 'contact.message' | t }}</label>
          <textarea id="ContactMessage" name="contact[body]" rows="5" required>{{ form.body }}</textarea>
        </div>

        <button type="submit" class="btn btn-full">{{ 'contact.submit' | t }}</button>
      {%- endform -%}
    </div>

    <div class="contact-info-col">
      <h2>{{ section.settings.info_heading }}</h2>
      <ul class="contact-info-list" role="list">
        {%- if section.settings.email != blank -%}
          <li>
            <span class="lbl">{{ 'contact.email' | t }}</span>
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          </li>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
          <li>
            <span class="lbl">{{ 'contact.phone' | t }}</span>
            <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
          </li>
        {%- endif -%}
      </ul>
      {%- if section.settings.whatsapp != blank or section.settings.instagram != blank or section.settings.facebook_url != blank -%}
        <div class="contact-social" role="list">
          {%- if section.settings.whatsapp != blank -%}
            <a class="contact-social-btn" href="https://wa.me/{{ section.settings.whatsapp | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 3a8.5 8.5 0 0 0-7.4 12.7L3 21l5.5-1.5A8.5 8.5 0 1 0 12 3Z" stroke="currentColor" stroke-width="1.6"/>
                <path d="M8.7 8.4c.2-.5.4-.5.7-.5h.5c.2 0 .4 0 .6.4.2.4.6 1.4.6 1.5.1.1.1.3 0 .4-.1.2-.1.3-.3.4-.1.2-.3.3-.4.5-.1.1-.3.3-.1.6.2.3.7 1.1 1.5 1.8.9.9 1.7 1.2 2 1.3.3.1.4.1.6-.1.2-.2.7-.8.9-1.1.2-.2.4-.2.6-.1l1.5.7c.2.1.4.2.4.4.1.2.1 1-.2 1.4-.4.6-1.4 1.1-2 1.1-.7.1-1.6.1-4-1-2.9-1.2-4.7-4-4.8-4.2-.1-.2-1-1.3-1-2.5 0-1.2.6-1.8.8-2Z" fill="currentColor"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.instagram != blank -%}
            <a class="contact-social-btn" href="https://instagram.com/{{ section.settings.instagram | remove: '@' }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5"/>
                <circle cx="12" cy="12" r="4.2"/>
                <circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.facebook_url != blank -%}
            <a class="contact-social-btn" href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="{{ section.settings.facebook_label }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/>
                <path d="M14 8.6h-1.3c-.8 0-1.2.5-1.2 1.3v1.8h2.4l-.3 2.3h-2.1V21"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact info",
  "settings": [
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send a message" },
    { "type": "text", "id": "info_heading", "label": "Info heading", "default": "Other ways to reach us" },
    { "type": "header", "content": "Direct contact details" },
    { "type": "text", "id": "email", "label": "Email" },
    { "type": "text", "id": "phone", "label": "Phone (with country code)" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number (with country code)" },
    { "type": "text", "id": "instagram", "label": "Instagram handle (with @)" },
    { "type": "url", "id": "facebook_url", "label": "Facebook page URL" },
    { "type": "text", "id": "facebook_label", "label": "Facebook display label", "default": "Facebook" }
  ],
  "presets": [
    { "name": "Contact info" }
  ]
}
{% endschema %}
