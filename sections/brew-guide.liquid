{%- liquid
  assign stat_blocks = section.blocks | where: 'type', 'stat'
  assign step_blocks = section.blocks | where: 'type', 'guide_step'
-%}
<section class="section brew-guide" aria-label="{{ section.settings.heading | default: 'Brew guide' | strip_html }}">
  <div class="wrap">
    {%- if stat_blocks.size > 0 -%}
      <div class="spec-row spec-row--compact">
        {%- for block in stat_blocks -%}
          <div class="spec-item" {{ block.shopify_attributes }}>
            <div class="spec-label">{{ block.settings.label }}</div>
            <div class="spec-value">{{ block.settings.value }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="section-head">
      <div class="lbl">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading | newline_to_br }}</h2>
      <div class="meta">{{ section.settings.meta | newline_to_br }}</div>
    </div>

    <div class="guide-list">
      {%- for block in step_blocks -%}
        <div class="guide-row" {{ block.shopify_attributes }}>
          <div class="guide-num">{{ block.settings.number }}</div>
          <div class="guide-content">
            <h3 class="guide-title">{{ block.settings.title }}</h3>
            <p class="guide-body">{{ block.settings.body }}</p>
            {%- if block.settings.tip != blank -%}
              <p class="guide-tip"><span>Why it matters —</span> {{ block.settings.tip }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brew guide",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The long version." },
    { "type": "text", "id": "meta", "label": "Meta (right)", "default": "Read once" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Variable",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Water temp" },
        { "type": "text", "id": "value", "label": "Value", "default": "93°C" }
      ]
    },
    {
      "type": "guide_step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Tear." },
        { "type": "textarea", "id": "body", "label": "Body" },
        { "type": "textarea", "id": "tip", "label": "Why it matters" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    { "name": "Brew guide" }
  ]
}
{% endschema %}
