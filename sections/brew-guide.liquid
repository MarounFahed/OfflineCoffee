<section class="section brew-guide" aria-label="{{ section.settings.heading | default: 'Brew guide' | strip_html }}">
  <div class="wrap">
    <div class="section-head">
      <div class="lbl">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading | newline_to_br }}</h2>
      <div class="meta">{{ section.settings.meta | newline_to_br }}</div>
    </div>

    <div class="guide-list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'guide_step' -%}
          <div class="guide-row" {{ block.shopify_attributes }}>
            <div class="guide-num">{{ block.settings.number }}</div>
            <div class="guide-content">
              <h3 class="guide-title">{{ block.settings.title }}</h3>
              <p class="guide-body">{{ block.settings.body }}</p>
              {%- if block.settings.tip != blank -%}
                <p class="guide-tip"><span>Why it matters —</span> {{ block.settings.tip }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brew guide",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "§ Step by step" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The long version." },
    { "type": "text", "id": "meta", "label": "Meta (right)", "default": "Read once\nBrew from memory after" }
  ],
  "blocks": [
    {
      "type": "guide_step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Tear." },
        { "type": "textarea", "id": "body", "label": "Body" },
        { "type": "textarea", "id": "tip", "label": "Why it matters" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Brew guide" }
  ]
}
{% endschema %}
