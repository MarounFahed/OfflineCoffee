<section class="section" aria-label="{{ section.settings.heading | default: 'How to brew' | strip_html }}">
  <div class="wrap">
    <div class="section-head">
      <div class="lbl">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading | newline_to_br }}</h2>
      <div class="meta">{{ section.settings.meta | newline_to_br }}</div>
    </div>

    <div class="brew">
      {%- for block in section.blocks -%}
        {%- if block.type == 'step' -%}
          <div class="brew-step" {{ block.shopify_attributes }}>
            <div class="brew-num">{{ block.settings.number }}</div>
            <div class="brew-title">{{ block.settings.title }}</div>
            <div class="brew-body">{{ block.settings.body }}</div>
            {%- if block.settings.footnote != blank -%}
              <div class="brew-foot">{{ block.settings.footnote }}</div>
            {%- endif -%}
            {%- if block.settings.show_timer -%}
              <button class="timer-pill"
                id="timerPill"
                type="button"
                data-seconds="{{ block.settings.timer_seconds | default: 300 }}"
                data-label-start="{{ block.settings.timer_label_start | default: 'Start brew' | escape }}"
                data-label-running="{{ block.settings.timer_label_running | default: 'Brewing…' | escape }}"
                data-label-resume="{{ 'Resume' | escape }}"
                data-label-done="{{ block.settings.timer_label_done | default: 'Ready.' | escape }}">
                <span class="timer-digits" id="timerDigits">05:00</span>
                <span id="timerLabel">{{ block.settings.timer_label_start | default: 'Start brew' }}</span>
              </button>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brew strip",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "§ 02 — The Brew" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Five minutes.\nThat's it." },
    { "type": "text", "id": "meta", "label": "Meta (right)", "default": "No machine\nNo grinder" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "00" },
        { "type": "text", "id": "title", "label": "Title", "default": "Boil." },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Fresh water, just off the boil. Around 93°C. A kettle whistle works fine." },
        { "type": "text", "id": "footnote", "label": "Footnote (mono)", "default": "93° C" },
        { "type": "header", "content": "Timer (only on the last step usually)" },
        { "type": "checkbox", "id": "show_timer", "label": "Show timer button", "default": false },
        { "type": "number", "id": "timer_seconds", "label": "Timer seconds", "default": 300 },
        { "type": "text", "id": "timer_label_start", "label": "Label — start", "default": "Start brew" },
        { "type": "text", "id": "timer_label_running", "label": "Label — running", "default": "Brewing…" },
        { "type": "text", "id": "timer_label_done", "label": "Label — done", "default": "Ready." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Brew strip",
      "blocks": [
        { "type": "step", "settings": { "number": "01", "title": "Tear.", "body": "Open the notch and tear straight across. No scissors, no mess.", "footnote": "1 bag · 1 mug" } },
        { "type": "step", "settings": { "number": "02", "title": "Soak.", "body": "Hang the tab over the rim of your mug and pour hot water through the filter until it's fully submerged.", "footnote": "93° C" } },
        { "type": "step", "settings": { "number": "03", "title": "Wait.", "body": "Five minutes. Don't check your phone. We wrote a timer in case you need one.", "footnote": "5 MINUTES", "show_timer": true } },
        { "type": "step", "settings": { "number": "04", "title": "Lift.", "body": "Lift the filter out, give it one gentle press against the mug, and sip.", "footnote": "Compostable · Backyard-safe" } }
      ]
    }
  ]
}
{% endschema %}
