<section class="section" aria-label="{{ section.settings.heading | default: 'Brew specs' }}">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <div class="coll-eyebrow">{{ section.settings.heading }}</div>
    {%- endif -%}
    <div class="spec-row">
      {%- for block in section.blocks -%}
        {%- if block.type == 'stat' -%}
          <div class="spec-item" {{ block.shopify_attributes }}>
            <div class="spec-label">{{ block.settings.label }}</div>
            <div class="spec-value">{{ block.settings.value }}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brew spec band",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Eyebrow", "default": "§ The variables" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Water temp" },
        { "type": "text", "id": "value", "label": "Value", "default": "93°C" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Brew spec band",
      "blocks": [
        { "type": "stat", "settings": { "label": "Water temp", "value": "93°C — just off the boil" } },
        { "type": "stat", "settings": { "label": "Ratio", "value": "1 filter : 350ml water" } },
        { "type": "stat", "settings": { "label": "Time", "value": "5 minutes, no more" } },
        { "type": "stat", "settings": { "label": "Water", "value": "Filtered tastes best" } }
      ]
    }
  ]
}
{% endschema %}
