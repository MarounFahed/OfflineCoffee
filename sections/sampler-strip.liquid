{%- liquid
  assign sampler_product = blank
  if section.settings.product != blank
    assign sampler_product = all_products[section.settings.product]
  endif
-%}

<section class="sampler-band" aria-label="{{ section.settings.heading | default: 'Sampler' | strip_html }}">
  <div class="sampler-band-img">
    {%- if sampler_product and sampler_product.featured_image -%}
      {% render 'responsive-image',
        image: sampler_product.featured_image,
        sizes: '(min-width: 800px) 40vw, 100vw',
        widths: '400, 600, 900, 1200',
        alt: sampler_product.title %}
    {%- endif -%}
  </div>
  <div class="sampler-band-body">
    {%- if section.settings.eyebrow != blank -%}
      <div class="lbl">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    <h2>{{ section.settings.heading | newline_to_br }}</h2>
    {%- if section.settings.body != blank -%}
      <p>{{ section.settings.body }}</p>
    {%- endif -%}
    {%- if sampler_product and section.settings.show_price -%}
      <div class="sampler-band-price">
        {%- if sampler_product.compare_at_price > sampler_product.price -%}
          <span class="compare-price">{{ sampler_product.compare_at_price | money }}</span>
        {%- endif -%}
        {{ sampler_product.price | money }}
      </div>
    {%- endif -%}
    {%- if sampler_product -%}
      <a class="btn" href="{{ sampler_product.url }}">{{ section.settings.cta_text | default: 'Shop the sampler' }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sampler strip",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "§ Bonus round" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Can't decide?\nTry all three." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "One bag of each roast, one box. The easiest way to find out which one's yours." },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Shop the sampler" }
  ],
  "presets": [
    { "name": "Sampler strip" }
  ]
}
{% endschema %}
