{%- liquid
  assign mood = section.settings.mood
  assign mood_color = '--pine'
  if mood == 'amber'
    assign mood_color = '--amber'
  elsif mood == 'ember'
    assign mood_color = '--ember'
  elsif mood == 'pine'
    assign mood_color = '--pine'
  endif
-%}

{%- comment -%}
  LCP signal: the hero <img> uses loading="eager" + fetchpriority="high"
  which the browser treats as a preload hint. Avoids the layout-level
  `<link rel="preload">` ordering issues per brief §11.2.
{%- endcomment -%}
<section class="hero" style="--mood: var({{ mood_color }});" aria-label="Hero">
  {%- if section.settings.background_image != blank -%}
    {% render 'responsive-image',
      image: section.settings.background_image,
      sizes: '100vw',
      widths: '600, 900, 1200, 1600, 2400',
      loading: 'eager',
      fetchpriority: 'high',
      alt: '',
      class: 'hero-image' %}
  {%- endif -%}

  {%- if section.settings.show_coord_marks -%}
    <div class="hero-coord-marks" aria-hidden="true">
      {%- if section.settings.coord_mark_1 != blank -%}<span>{{ section.settings.coord_mark_1 }}</span>{%- endif -%}
      {%- if section.settings.coord_mark_2 != blank -%}<span>{{ section.settings.coord_mark_2 }}</span>{%- endif -%}
      {%- if section.settings.coord_mark_3 != blank -%}<span>{{ section.settings.coord_mark_3 }}</span>{%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.settings.stamp_text != blank -%}
    <div class="hero-stamp">{{ section.settings.stamp_text | newline_to_br }}</div>
  {%- endif -%}

  {%- if section.settings.show_character and settings.logo_character != blank -%}
    {{ settings.logo_character | image_url: width: 1200 | image_tag:
      loading: 'eager',
      widths: '600, 900, 1200',
      sizes: '50vw',
      alt: '',
      class: 'hero-character' }}
  {%- endif -%}

  {%- if section.settings.eyebrow != blank -%}
    <div class="hero-eyebrow">{{ section.settings.eyebrow }}</div>
  {%- endif -%}

  <h1>{{ section.settings.heading | newline_to_br | default: 'Out of range.<br>On purpose.' }}</h1>

  {%- if section.settings.lead != blank -%}
    <p class="lead">{{ section.settings.lead }}</p>
  {%- endif -%}

  {%- if section.settings.cta_primary_text != blank or section.settings.cta_secondary_text != blank -%}
    <div class="hero-ctas">
      {%- if section.settings.cta_primary_text != blank -%}
        <a class="btn btn-arrow" href="{{ section.settings.cta_primary_link | default: '#' }}">{{ section.settings.cta_primary_text }}</a>
      {%- endif -%}
      {%- if section.settings.cta_secondary_text != blank -%}
        <a class="btn btn-secondary" href="{{ section.settings.cta_secondary_link | default: '#' }}">{{ section.settings.cta_secondary_text }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.settings.show_scroll_cue -%}
    <div class="scroll-cue" aria-hidden="true">{{ section.settings.scroll_cue_text | default: 'Keep reading' }}</div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "mood",
      "label": "Roast mood (background)",
      "options": [
        { "value": "amber", "label": "Amber (light roast)" },
        { "value": "ember", "label": "Ember (medium roast)" },
        { "value": "pine", "label": "Pine (dark roast)" }
      ],
      "default": "pine"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image (overrides mood color)",
      "info": "If set, image fills the hero with the mood color blending over it."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Blend № 03 · Pine Hollow · Dark roast"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Out of range.\nOn purpose.",
      "info": "Use line breaks to control wrapping."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Sub-copy",
      "default": "Specialty coffee in a compostable filter sachet. Hot water. Four minutes. The cabin doesn't need WiFi to make a good cup."
    },
    {
      "type": "header",
      "content": "Call-to-action"
    },
    { "type": "text", "id": "cta_primary_text", "label": "Primary CTA text", "default": "Shop the blends" },
    { "type": "url", "id": "cta_primary_link", "label": "Primary CTA link" },
    { "type": "text", "id": "cta_secondary_text", "label": "Secondary CTA text", "default": "Read the why" },
    { "type": "url", "id": "cta_secondary_link", "label": "Secondary CTA link" },
    {
      "type": "header",
      "content": "Decorations"
    },
    { "type": "checkbox", "id": "show_character", "label": "Show character mark", "default": true },
    { "type": "checkbox", "id": "show_coord_marks", "label": "Show coordinate marks (top-left)", "default": true },
    { "type": "text", "id": "coord_mark_1", "label": "Coord mark 1", "default": "N 38°51′" },
    { "type": "text", "id": "coord_mark_2", "label": "Coord mark 2", "default": "W 119°57′" },
    { "type": "text", "id": "coord_mark_3", "label": "Coord mark 3", "default": "EL 6,224 FT" },
    { "type": "textarea", "id": "stamp_text", "label": "Stamp (top-right, supports line breaks)", "default": "Steeped here\nN 38°51′ / W 119°57′\n14 Aug · 06:42" },
    { "type": "checkbox", "id": "show_scroll_cue", "label": "Show scroll cue", "default": true },
    { "type": "text", "id": "scroll_cue_text", "label": "Scroll cue text", "default": "Keep reading" }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
