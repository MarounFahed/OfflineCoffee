<section class="compost{% if section.settings.background == 'amber' %} compost--amber{% elsif section.settings.background == 'ember' %} compost--ember{% elsif section.settings.background == 'paper' %} compost--paper{% endif %}">
  <div class="compost-inner">
    <div>
      <h2>{{ section.settings.heading | newline_to_br }}</h2>
      {%- if section.settings.tag != blank -%}
        <span class="compost-tag">{{ section.settings.tag }}</span>
      {%- endif -%}
    </div>
    <div class="compost-body">
      {%- if section.settings.image != blank -%}
        {% render 'responsive-image',
          image: section.settings.image,
          sizes: '(min-width: 800px) 33vw, 100vw',
          widths: '400, 600, 800',
          alt: '',
          class: 'compost-image' %}
      {%- elsif section.settings.image_url != blank -%}
        <img
          src="{{ section.settings.image_url }}&width=800"
          srcset="{{ section.settings.image_url }}&width=400 400w, {{ section.settings.image_url }}&width=600 600w, {{ section.settings.image_url }}&width=800 800w"
          sizes="(min-width: 800px) 33vw, 100vw"
          alt=""
          loading="lazy"
          class="compost-image">
      {%- endif -%}
      <p>{{ section.settings.body }}</p>
      {%- if section.settings.cta_text != blank and section.settings.cta_url != blank -%}
        <a href="{{ section.settings.cta_url }}" class="btn btn-secondary compost-cta">{{ section.settings.cta_text }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Compost callout",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "pine", "label": "Pine (default)" },
        { "value": "ember", "label": "Ember" },
        { "value": "amber", "label": "Amber" },
        { "value": "paper", "label": "Paper-2 (light)" }
      ],
      "default": "pine"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Compostable.\nNot just recyclable." },
    { "type": "image_picker", "id": "image", "label": "Image (above body text)" },
    { "type": "text", "id": "image_url", "label": "Image URL (fallback, advanced)" },
    { "type": "text", "id": "tag", "label": "Tag (callout)", "default": "100% Plant-based filter · OK for your backyard compost" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "The filter is plant fiber and corn starch. The wrapper is uncoated kraft. The box is the box. Bury the whole thing in the garden and it'll be soil by spring." },
    { "type": "text", "id": "cta_text", "label": "CTA text (optional)" },
    { "type": "url", "id": "cta_url", "label": "CTA link (optional)" }
  ],
  "presets": [
    { "name": "Compost callout" }
  ]
}
{% endschema %}
