<section class="blog-head">
  <h1>{{ section.settings.heading | default: blog.title }}</h1>
  {%- if section.settings.subhead != blank -%}
    <div class="mono">{{ section.settings.subhead }}</div>
  {%- endif -%}
</section>

{%- paginate blog.articles by section.settings.posts_per_page -%}
  {%- if section.settings.show_featured and blog.articles.size > 0 -%}
    {%- assign featured = blog.articles.first -%}
    <a class="blog-feature" href="{{ featured.url }}">
      <div class="journal-art">
        {%- if featured.image != blank -%}
          {% render 'responsive-image',
            image: featured.image,
            sizes: '(min-width: 990px) 60vw, 100vw',
            widths: '600, 900, 1200, 1600, 2400',
            loading: 'eager',
            alt: featured.title }}
        {%- else -%}
          <span class="lbl">[ FEATURED · {{ featured.title | upcase | truncate: 24 }} ]</span>
        {%- endif -%}
      </div>
      <div>
        <div class="journal-meta">{{ featured.published_at | date: '%d %b' }} · {{ featured.tags | first | default: 'Journal' }}</div>
        <h2 class="journal-title">{{ featured.title }}</h2>
        <p class="journal-dek">{{ featured.excerpt_or_content | strip_html | truncatewords: 32 }}</p>
      </div>
    </a>
  {%- endif -%}

  {%- if blog.articles.size > 0 -%}
    <div class="blog-grid">
      {%- assign skip = section.settings.show_featured -%}
      {%- for article in blog.articles -%}
        {%- if skip and forloop.first -%}{%- continue -%}{%- endif -%}
        <a class="journal-card" href="{{ article.url }}">
          <div class="journal-art">
            {%- if article.image != blank -%}
              {% render 'responsive-image',
                image: article.image,
                sizes: '(min-width: 990px) 33vw, 100vw',
                widths: '400, 600, 900, 1200',
                alt: article.title %}
            {%- else -%}
              <span class="lbl">[ {{ article.title | upcase | truncate: 28 }} ]</span>
            {%- endif -%}
          </div>
          <div class="journal-meta">{{ article.published_at | date: '%d %b' }} · {{ article.tags | first | default: 'Journal' }}</div>
          <h3 class="journal-title">{{ article.title }}</h3>
          <p class="journal-dek">{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
        </a>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="coll-foot" role="navigation" aria-label="Pagination">
        <span>{%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">← {{ 'general.pagination.previous' | t }}</a>{%- endif -%}</span>
        <span class="center">{{ 'general.pagination.page' | t }} {{ paginate.current_page }} / {{ paginate.pages }}</span>
        <span class="right">{%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }} →</a>{%- endif -%}</span>
      </nav>
    {%- endif -%}
  {%- else -%}
    <div class="cart-empty">
      <h1>Nothing in the journal yet.</h1>
      <a class="btn-link" href="{{ routes.root_url }}">← Back home</a>
    </div>
  {%- endif -%}
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Journal." },
    { "type": "text", "id": "subhead", "label": "Subhead (mono)", "default": "Field notes, brew logs, occasional opinions." },
    { "type": "checkbox", "id": "show_featured", "label": "Feature first post (full-width)", "default": true },
    { "type": "range", "id": "posts_per_page", "label": "Posts per page", "min": 6, "max": 24, "step": 3, "default": 12 }
  ]
}
{% endschema %}
