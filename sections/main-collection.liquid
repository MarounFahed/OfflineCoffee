{%- liquid
  assign products_per_page = section.settings.products_per_page | default: 12
  assign sort_by = collection.sort_by | default: collection.default_sort_by

  assign editorial_blocks = section.blocks | where: 'type', 'editorial_break'
-%}

<section class="coll-header">
  <div>
    <div class="coll-eyebrow">{{ section.settings.eyebrow }}</div>
    <h1 class="coll-title">{{ collection.title | default: section.settings.title_override | default: 'The shop.' }}</h1>
  </div>
  <div>
    {%- if section.settings.description != blank -%}
      <p class="coll-desc">{{ section.settings.description }}</p>
    {%- elsif collection.description != blank -%}
      <p class="coll-desc">{{ collection.description }}</p>
    {%- endif -%}
    {%- if section.settings.show_meta -%}
      <div class="coll-meta">
        <span>{{ section.settings.meta_1 }}</span>
        <span>{{ section.settings.meta_2 }}</span>
        <span>{{ section.settings.meta_3 }}</span>
      </div>
    {%- endif -%}
  </div>
</section>

<div class="filter-bar">
  <div class="filter-inner">
    {%- comment -%}
      Storefront filters from Shopify Admin > Online Store > Navigation > Collections.
      Falls back to a visual-only template if no filters are configured yet.
    {%- endcomment -%}
    {%- if collection.filters.size > 0 -%}
      <form id="CollectionFilterForm" method="get">
        {%- for filter in collection.filters limit: 3 -%}
          <div class="filter-group" data-filter-group>
            <span class="filter-group-label">{{ filter.label }}</span>
            {%- for value in filter.values -%}
              <button
                type="button"
                class="pill{% if value.active %} active{% endif %}"
                data-filter-url="{{ value.url_to_add | default: value.url_to_remove }}"
                aria-pressed="{% if value.active %}true{% else %}false{% endif %}"
                onclick="window.location.href='{{ value.url_to_add | default: value.url_to_remove }}'">
                {{ value.label }}
              </button>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </form>
    {%- else -%}
      {%- comment -%} Visual fallback — wire native filters in Admin to activate. {%- endcomment -%}
      <div class="filter-group" data-filter-group>
        <span class="filter-group-label">{{ 'collections.general.filter.roast' | t }}</span>
        <button class="pill active" type="button" aria-pressed="true">{{ 'collections.general.all' | t }}</button>
        <button class="pill" type="button" aria-pressed="false">Light</button>
        <button class="pill" type="button" aria-pressed="false">Medium</button>
        <button class="pill" type="button" aria-pressed="false">Dark</button>
      </div>
      <div class="filter-group" data-filter-group>
        <span class="filter-group-label">{{ 'collections.general.filter.intensity' | t }}</span>
        <button class="pill" type="button" aria-pressed="false">1 Bar</button>
        <button class="pill" type="button" aria-pressed="false">2 Bars</button>
        <button class="pill" type="button" aria-pressed="false">3 Bars</button>
      </div>
    {%- endif -%}

    <div class="filter-spacer"></div>

    <div class="filter-count">
      {{ 'collections.general.items_with_count' | t: count: collection.products_count }}
    </div>

    <form method="get" class="filter-sort-form" style="display:flex;align-items:center;gap:var(--s-3);">
      <label for="SortBy" class="visually-hidden">{{ 'collections.general.sort_by' | t }}</label>
      <select name="sort_by" id="SortBy" class="filter-sort" onchange="this.form.submit()" style="background:transparent; border:0; cursor:pointer;">
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
    </form>
  </div>
</div>

{%- paginate collection.products by products_per_page -%}
  {%- if collection.products.size > 0 -%}
    <section class="coll-grid" id="ProductGrid">
      {%- for product in collection.products -%}
        {%- assign idx = forloop.index -%}

        {% render 'product-card', product: product, variant: 'grid' %}

        {%- comment -%} Inject editorial breaks at configured product index. {%- endcomment -%}
        {%- for ed in editorial_blocks -%}
          {%- if ed.settings.after_product_n == idx -%}
            <div class="editorial" {{ ed.shopify_attributes }}>
              <div>
                <div class="coll-eyebrow" style="margin-bottom: var(--s-5);">{{ ed.settings.eyebrow }}</div>
                <p class="editorial-quote">{{ ed.settings.quote }}</p>
                {%- if ed.settings.attribution != blank -%}
                  <div class="editorial-meta">{{ ed.settings.attribution }}</div>
                {%- endif -%}
              </div>
              <div class="editorial-img">
                {%- if ed.settings.image != blank -%}
                  {% render 'responsive-image',
                    image: ed.settings.image,
                    sizes: '50vw',
                    widths: '600, 900, 1200, 1600',
                    alt: ed.settings.attribution %}
                {%- endif -%}
                {%- if ed.settings.stamp != blank -%}<div class="stamp">{{ ed.settings.stamp }}</div>{%- endif -%}
                {%- if ed.settings.label != blank -%}<span>{{ ed.settings.label }}</span>{%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </section>

    {%- if section.settings.show_foot -%}
      <div class="coll-foot">
        <span>{{ 'collections.general.showing_of' | t: count: collection.products.size, total: collection.products_count }}</span>
        <span class="center">{{ section.settings.foot_center }}</span>
        <span class="right">
          {%- if section.settings.foot_link_url != blank -%}
            <a href="{{ section.settings.foot_link_url }}">{{ section.settings.foot_link_text }} ↗</a>
          {%- endif -%}
        </span>
      </div>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="coll-foot" role="navigation" aria-label="Pagination">
        <span>{%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">← {{ 'general.pagination.previous' | t }}</a>{%- endif -%}</span>
        <span class="center">{{ 'general.pagination.page' | t }} {{ paginate.current_page }} / {{ paginate.pages }}</span>
        <span class="right">{%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }} →</a>{%- endif -%}</span>
      </nav>
    {%- endif -%}
  {%- else -%}
    <div class="coll-empty">
      <h2>{{ 'collections.general.no_matches' | t }}</h2>
      <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'collections.general.all' | t }}</a>
    </div>
  {%- endif -%}
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "§ The Pack — All blends · Three roasts · One ritual" },
    { "type": "text", "id": "title_override", "label": "Title override (uses collection title if blank)" },
    { "type": "textarea", "id": "description", "label": "Description override (uses collection description if blank)" },
    { "type": "checkbox", "id": "show_meta", "label": "Show meta line", "default": true },
    { "type": "text", "id": "meta_1", "label": "Meta 1", "default": "3 blends" },
    { "type": "text", "id": "meta_2", "label": "Meta 2", "default": "+ 2 packs" },
    { "type": "text", "id": "meta_3", "label": "Meta 3", "default": "Ships in 2 days" },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 6, "max": 36, "step": 3, "default": 12 },
    { "type": "header", "content": "Footer (below grid)" },
    { "type": "checkbox", "id": "show_foot", "label": "Show foot row", "default": true },
    { "type": "text", "id": "foot_center", "label": "Center note", "default": "— Hand-roasted weekly —" },
    { "type": "text", "id": "foot_link_text", "label": "Right link text", "default": "How to brew" },
    { "type": "url", "id": "foot_link_url", "label": "Right link URL" }
  ],
  "blocks": [
    {
      "type": "editorial_break",
      "name": "Editorial break",
      "settings": [
        { "type": "range", "id": "after_product_n", "label": "After product #", "min": 1, "max": 24, "step": 1, "default": 3 },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "§ Field note · 12 Aug" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "\"The best coffee on a four-day backpacking trip is the one you don't have to think about. Steep. Wait. Drink. Pack out the sachet.\"" },
        { "type": "text", "id": "attribution", "label": "Attribution", "default": "— From the journal · Vol. 03" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "stamp", "label": "Stamp", "default": "N 44°25′ / W 110°35′" },
        { "type": "text", "id": "label", "label": "Bottom-right label", "default": "[ EDITORIAL · 1200 × 1200 ]" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection grid"
    }
  ]
}
{% endschema %}
