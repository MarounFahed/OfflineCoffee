<section class="origin-story" aria-label="{{ section.settings.heading | default: 'Story' | strip_html }}">
  <div class="img">
    {%- if section.settings.image != blank -%}
      {% render 'responsive-image',
        image: section.settings.image,
        sizes: '(min-width: 990px) 50vw, 100vw',
        widths: '400, 600, 900, 1200, 1600',
        alt: section.settings.heading %}
    {%- endif -%}
    {%- if section.settings.stamp != blank -%}
      <div class="stamp">{{ section.settings.stamp }}</div>
    {%- endif -%}
  </div>
  <div>
    <h2>{{ section.settings.heading | newline_to_br }}</h2>
    {%- for block in section.blocks -%}
      {%- if block.type == 'paragraph' -%}
        <p {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Origin story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "stamp", "label": "Coordinate stamp", "default": "N 06°08′ / E 38°12′" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sourcing\nthe slow way." }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "Paragraph",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Origin story",
      "blocks": [
        { "type": "paragraph", "settings": { "text": "We buy direct from a handful of farms we visit each year. Smaller lots, fairer prices, and a list of names instead of a co-op number." } },
        { "type": "paragraph", "settings": { "text": "The coffee gets roasted in small batches in Brooklyn, ground the same week, and sealed into compostable filter sachets. Then it leaves the warehouse and shows up at your door." } }
      ]
    }
  ]
}
{% endschema %}
