<div class="form-stack">
  <h1>{{ 'customer.reset_password.title' | t }}</h1>
  <p class="mono ink-soft">{{ 'customer.reset_password.subtext' | t }}</p>

  {%- form 'reset_customer_password', novalidate: 'novalidate' -%}
    {%- if form.errors -%}
      <div class="form-error" role="alert">
        {%- for field in form.errors -%}<span>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}.</span>{%- endfor -%}
      </div>
    {%- endif -%}
    <div class="field">
      <label for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
      <input type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required>
    </div>
    <div class="field">
      <label for="ResetPasswordConfirmation">{{ 'customer.reset_password.password_confirm' | t }}</label>
      <input type="password" id="ResetPasswordConfirmation" name="customer[password_confirmation]" autocomplete="new-password" required>
    </div>
    <button type="submit" class="btn">{{ 'customer.reset_password.submit' | t }}</button>
  {%- endform -%}
</div>
