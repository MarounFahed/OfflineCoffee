<div class="quick-view" id="quickView" aria-hidden="true">
  <div class="quick-view-overlay" data-qv-close></div>
  <div class="quick-view-panel" role="dialog" aria-modal="true" aria-label="{{ 'products.product.quick_view' | t }}">
    <button type="button" class="quick-view-close" data-qv-close aria-label="{{ 'general.accessibility.close' | t }}">{{ 'general.accessibility.close' | t }}</button>
    <div class="quick-view-content" data-qv-content></div>
  </div>
</div>
