{%- comment -%}
  Inline SVG icon. Param: name (search / cart / account / arrow-right / close / menu / hamburger).
{%- endcomment -%}
{%- case name -%}
  {%- when 'search' -%}
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="7" cy="7" r="5"/><path d="m11 11 4 4"/></svg>
  {%- when 'account' -%}
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="8" cy="5" r="3"/><path d="M2 14c0-3 2.5-5 6-5s6 2 6 5"/></svg>
  {%- when 'cart' -%}
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M2 3h2l2 9h7l1-7H5"/><circle cx="6.5" cy="14" r="1"/><circle cx="12" cy="14" r="1"/></svg>
  {%- when 'close' -%}
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="m3 3 10 10M13 3 3 13"/></svg>
  {%- when 'menu' -%}
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14"/></svg>
  {%- when 'arrow-right' -%}
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M2 7h10M9 4l3 3-3 3"/></svg>
{%- endcase -%}
